ENVIRONMENT=development
DATABASE_URL=sqlite:///./qarar.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# V8 authentication. This example key is FOR LOCAL DEVELOPMENT ONLY.
# Replace all keys before any shared/pilot environment.
AUTH_REQUIRED=true
QARAR_API_KEYS_JSON={"qarar-local-dev-key-change-me":{"tenant_id":"local-dev","subject":"local-admin","roles":["admin","executive","project_manager","developer"]}}

AI_ENABLED=false
AI_PROVIDER=mock
AI_MODEL=gpt-5.6-luna
AI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
RESPONSE_LANGUAGE=ar
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
ESTIMATED_INPUT_USD_PER_MILLION=1.25
ESTIMATED_OUTPUT_USD_PER_MILLION=10.0

MAX_FILE_MB=100
INGESTION_MODE=sync
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_PATH=./data/objects
S3_ENDPOINT_URL=
S3_BUCKET=qarar
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
CHUNK_CHARS=2200
CHUNK_OVERLAP=300
HYBRID_VECTOR_WEIGHT=0.55
HYBRID_LEXICAL_WEIGHT=0.30
HYBRID_TRUST_WEIGHT=0.15

RESEARCH_ENABLED=false
RESEARCH_MODE_DEFAULT=official_plus_organization
OFFICIAL_DOMAINS=nca.gov.sa,dga.gov.sa,sdaia.gov.sa,cst.gov.sa
PUBLIC_WEB_ENABLED=false

IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_USE_SSL=true
M365_CLIENT_ID=
M365_TENANT_ID=
M365_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_TOKEN=

MCP_PUBLIC_BASE_URL=http://localhost:8001
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MCP_API_KEY=
MCP_TENANT_ID=local-dev
MCP_SERVERS_FILE=./config/mcp_servers.json

AUTOMATION_ENABLED=false
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_API_KEY=
AUTOMATION_REQUIRE_APPROVAL=true
AUTOMATION_DRY_RUN=true
AUTOMATION_CALLBACK_SECRET=
AUTOMATION_CALLBACK_MAX_SKEW_SECONDS=300
AUTOMATION_ALLOWED_HOSTS=localhost,127.0.0.1,n8n
API_PUBLIC_BASE_URL=http://localhost:8000

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
