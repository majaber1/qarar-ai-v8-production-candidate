{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/"
    },
    "backend": {
      "entrypoint": "backend/service.py",
      "routePrefix": "/api",
      "maxDuration": 300,
      "includeFiles": "backend/config/**"
    }
  }
}
